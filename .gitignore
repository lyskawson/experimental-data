# Środowisko i pliki Pythona
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Cache narzędzi i notebooków
.ruff_cache/
.ipynb_checkpoints/
.jupyter/
.python_history

# Lokalne ustawienia i dane dostępowe
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.log

# Materiały prowadzącego pozostają lokalnie
/labs/*/materials/*
!/labs/*/materials/.gitkeep

# Pliki tymczasowe edytorów i arkuszy
*.swp
~$*
.~lock.*#

# Pliki konfiguracyjne IDE
.vscode/

# Local author details and build files
/tmp/
node_modules/
/labs/*/report/author.tex
/labs/*/report/main.pdf
/labs/*/report/*.aux
/labs/*/report/*.log
/labs/*/report/*.out
/labs/*/report/*.toc
/labs/*/report/*.fls
/labs/*/report/*.fdb_latexmk
/labs/*/submission/*
!/labs/*/submission/cw*.zip
/labs/*/outputs/report.pdf
/labs/*/data/data_zad3.png

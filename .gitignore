# Środowisko i pliki Pythona
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Cache narzędzi i notebooków
.ruff_cache/
.ipynb_checkpoints/
.jupyter/
.python_history

# Lokalne ustawienia i dane dostępowe
.env
.env.*
